{
  "name": "@tengu/cli",
  "version": "0.1.0",
  "description": "Tengu TUI (Pi TUI) and headless CLI / JSON-RPC interface",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tengu": "./dist/cli.js"
  },
  "scripts": {
    "clean": "node ../../scripts/package-files.mjs clean dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@tengu/store": "0.1.0",
    "@tengu/intercept": "0.1.0",
    "@tengu/ops": "0.1.0",
    "@tengu/engine": "0.1.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2"
  }
}
